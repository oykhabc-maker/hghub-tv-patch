diff --git a/src/index.css b/src/index.css
index 9539ea9..cd34550 100644
--- a/src/index.css
+++ b/src/index.css
@@ -558,3 +558,62 @@ html.theme-light .article-body { color: rgba(20,24,30,.82); }
 .hg-tabbar button:focus-visible,
 .hg-player-ui button:focus,
 .hg-player-ui button:focus-visible { outline: none; }
+
+/* ===================================================================
+   電視模式（遙控器）—— 由 src/tv/ 的引擎加上 html.tv-mode
+   焦點框只由 .tv-focus 畫（單一高亮），底部安全距離讓最後一列
+   不會被底欄蓋住，順便把幾個手機尺寸的字級放大到沙發可讀。
+   =================================================================== */
+/* 焦點框畫在元素自己身上（::after + inset），因為卡片常在
+   overflow:hidden 的橫向捲動列裡，往外畫的 outline 會被裁掉一半。 */
+html.tv-mode .tv-focus {
+  position: relative;
+  outline: none !important;
+  z-index: 1;
+}
+html.tv-mode .tv-focus::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  box-shadow: inset 0 0 0 4px #ffd54f, 0 0 0 3px rgba(255, 213, 79, .45);
+  pointer-events: none;
+  z-index: 6;
+}
+/* 輸入框沒有 ::after，退回 outline */
+html.tv-mode input.tv-focus,
+html.tv-mode textarea.tv-focus {
+  outline: 3px solid #ffd54f !important;
+  outline-offset: 2px !important;
+}
+html.tv-mode button:focus:not(.tv-focus),
+html.tv-mode [tabindex]:focus:not(.tv-focus) { outline: none !important; }
+
+/* 焦點移到底部時留出底欄高度，不被遮住 */
+html.tv-mode .scroll-y { scroll-padding-bottom: 96px; }
+html.tv-mode .scroll-y > * { scroll-margin-top: 24px; scroll-margin-bottom: 96px; }
+
+/* 底欄：電視上按得到、看得清 */
+html.tv-mode .hg-tabbar > div { height: 64px; }
+html.tv-mode .hg-tabbar span { font-size: 17px !important; }
+
+/* 手機字級 → 電視字級（只影響電視模式） */
+html.tv-mode .text-\[9\.5px\]  { font-size: 12px; }
+html.tv-mode .text-\[10px\]    { font-size: 12.5px; }
+html.tv-mode .text-\[10\.5px\] { font-size: 13px; }
+html.tv-mode .text-\[11px\]    { font-size: 13.5px; }
+html.tv-mode .text-\[11\.5px\] { font-size: 14px; }
+html.tv-mode .text-\[12px\]    { font-size: 14.5px; }
+html.tv-mode .text-\[12\.5px\] { font-size: 15px; }
+html.tv-mode .text-\[13px\]    { font-size: 15.5px; }
+html.tv-mode .text-\[13\.5px\] { font-size: 16px; }
+html.tv-mode .text-\[14\.5px\] { font-size: 17px; }
+html.tv-mode .text-\[15px\]    { font-size: 17.5px; }
+html.tv-mode .text-\[15\.5px\] { font-size: 18px; }
+html.tv-mode .text-\[17px\]    { font-size: 19px; }
+html.tv-mode .text-\[24px\]    { font-size: 30px; }
+
+/* 卡片尺寸：遙控器一次跳一格，格子太小會走到手指發痠 */
+html.tv-mode .w-\[104px\] { width: 148px; }
+html.tv-mode .w-\[52px\]  { width: 64px; }
+html.tv-mode .h-\[68px\]  { height: 84px; }
